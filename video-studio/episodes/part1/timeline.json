 "captions": [
  {
   "text": "This server had only",
   "start": 0.35,
   "end": 2.292,
   "juno": false
  },
  {
   "text": "one rule.",
   "start": 2.292,
   "end": 3.166,
   "juno": false
  },
  {
   "text": "Never. Open. The red",
   "start": 3.516,
   "end": 5.939,
   "juno": false
  },
  {
   "text": "door.",
   "start": 5.939,
   "end": 6.545,
   "juno": false
  },
  {
   "text": "Milo thought it was",
   "start": 7.095,
   "end": 8.782,
   "juno": false
  },
  {
   "text": "just a joke.",
   "start": 8.782,
   "end": 9.847,
   "juno": false
  },
  {
   "text": "But nobody ever went",
   "start": 10.347,
   "end": 11.876,
   "juno": false
  },
  {
   "text": "near it. Not even",
   "start": 11.876,
   "end": 13.176,
   "juno": false
  },
  {
   "text": "the admins.",
   "start": 13.176,
   "end": 14.017,
   "juno": false
  },
  {
   "text": "Then, at exactly midnight\u2026",
   "start": 14.517,
   "end": 17.098,
   "juno": false
  },
  {
   "text": "it knocked.",
   "start": 19.198,
   "end": 20.286,
   "juno": false
  },
  {
   "text": "From the inside.",
   "start": 20.786,
   "end": 22.493,
   "juno": false
  },
  {
   "text": "His best friend Juno",
   "start": 23.193,
   "end": 24.985,
   "juno": false
  },
  {
   "text": "whispered:",
   "start": 24.985,
   "end": 25.881,
   "juno": false
  },
  {
   "text": "Don't. Answer. It.",
   "start": 26.131,
   "end": 28.136,
   "juno": true
  },
  {
   "text": "Milo turned around for",
   "start": 28.636,
   "end": 30.599,
   "juno": false
  },
  {
   "text": "one second\u2026",
   "start": 30.599,
   "end": 31.58,
   "juno": false
  },
  {
   "text": "\u2026and Juno was gone.",
   "start": 32.08,
   "end": 34.171,
   "juno": false
  },
  {
   "text": "Then new words appeared",
   "start": 35.18,
   "end": 37.045,
   "juno": false
  },
  {
   "text": "on the door.",
   "start": 37.045,
   "end": 38.017,
   "juno": false
  },
  {
   "text": "And slowly\u2026 the red",
   "start": 39.717,
   "end": 41.46,
   "juno": false
  },
  {
   "text": "door started to open.",
   "start": 41.46,
   "end": 43.387,
   "juno": false
  }
 ],
